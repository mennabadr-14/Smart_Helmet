    {
        "id": "46337c0aa27f7b0e",
        "type": "function",
        "z": "4a7dbdfdd986f27f",
        "name": "Telemetry -> dashboard + map",
        "func": "const t = msg.payload;\nif (!t || typeof t !== 'object') return null;\nif (t.gas === undefined && t.oxygen !== undefined) { t.gas = Math.max(0, Math.round((98 - t.oxygen) / 40 * 100)); delete t.oxygen; }   // old senders\n// use the OwnTracks location when it is fresh (< 5 min), otherwise the helmet GPS\nconst ot = flow.get('ot');\nlet src = 'helmet';\nif (ot && (Date.now() - ot.ts) < 300000) { t.lat = ot.lat; t.lon = ot.lon; src = 'owntracks'; }\nflow.set('status', t.status || 'SAFE');\nconst ui = { payload: Object.assign({ kind: 'telemetry', src: src }, t) };\nlet map = null;\nif (typeof t.lat === 'number' && typeof t.lon === 'number') {\n  const colors = { 'SAFE': '#9aa4b2', 'NOISE': '#f5a524', 'FIRE': '#ff4d4f', 'FALL': '#ff4d4f', 'GAS': '#ff4d4f', 'NOT WORN': '#5b6470' };\n  map = { payload: { name: 'Worker-01', lat: t.lat, lon: t.lon, icon: 'fa-user',\n                     iconColor: colors[t.status] || '#9aa4b2',\n                     popup: 'Status: ' + (t.status || '-') + (t.temp !== undefined ? '<br>Temp: ' + t.temp + ' C' : '') } };\n}\nreturn [ui, map];",
