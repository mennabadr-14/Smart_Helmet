    {
      "id": 7,
      "type": "timeseries",
      "title": "VITALS HISTORY",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"helmet_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"helmet_telemetry\" and (r._field == \"temp\" or r._field == \"gas\"))\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#22C55E", "value": null } ] },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 3,
            "fillOpacity": 40,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisSoftMin": null,
            "barAlignment": 0,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/temp/" },
            "properties": [
              { "id": "displayName", "value": "Temperature" },
              { "id": "unit", "value": "celsius" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#F59E0B" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/gas/" },
            "properties": [
              { "id": "displayName", "value": "Gas Level" },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#EF4444" } },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [ "lastNotNull", "min", "max" ]
        },
        "tooltip": { "mode": "multi", "sort": "none" }
