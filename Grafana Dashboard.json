{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB (Flux)",
      "description": "",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 9,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "html",
        "code": { "language": "html", "showLineNumbers": false, "showMiniMap": false },
        "content": "<div style=\"text-align:center;font-size:30px;font-weight:700;letter-spacing:10px;color:#E2E8F0;\">SMART HELMET</div><div style=\"text-align:center;font-size:12px;letter-spacing:5px;color:#64748B;margin-top:4px;\">OIL SITE SAFETY CONSOLE</div>"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "WORKER STATUS",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 6, "w": 9, "x": 0, "y": 3 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"helmet_data\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"helmet_telemetry\" and r._field == \"worn\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"status\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "SAFE": { "index": 0, "color": "#22C55E", "text": "SAFE" },
                "FIRE": { "index": 1, "color": "#EF4444", "text": "FIRE" },
                "GAS": { "index": 2, "color": "#F59E0B", "text": "GAS LEAK" },
                "FALL": { "index": 3, "color": "#B91C1C", "text": "FALL" },
                "NOISE": { "index": 4, "color": "#FACC15", "text": "NOISE" },
                "NOT WORN": { "index": 5, "color": "#64748B", "text": "NOT WORN" }
              }
            }
          ],
          "noValue": "OFFLINE",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#64748B", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": [ "lastNotNull" ], "fields": "/^status$/" },
        "colorMode": "background_gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": { "valueSize": 56, "titleSize": 14 }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HELMET",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 6, "w": 5, "x": 9, "y": 3 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"helmet_data\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"helmet_telemetry\" and r._field == \"worn\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "OFFLINE",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "index": 0, "color": "#22C55E", "text": "HELMET ON" },
                "0": { "index": 1, "color": "#64748B", "text": "HELMET OFF" }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#64748B", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": [ "lastNotNull" ], "fields": "" },
        "colorMode": "background_gradient",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": { "valueSize": 30, "titleSize": 14 }
      }
    },
    {
      "id": 3,
      "type": "geomap",
      "title": "WORKER LOCATION",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 12, "w": 10, "x": 14, "y": 3 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"helmet_data\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"helmet_telemetry\" and (r._field == \"lat\" or r._field == \"lon\"))\n  |> drop(columns: [\"status\", \"device_id\"])\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"lat\", \"lon\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#22D3EE", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 15,
          "allLayers": false,
          "layer": "Worker",
          "lastOnly": true,
          "maxZoom": 17,
          "padding": 5,
          "shared": false
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": false,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "carto",
          "name": "Basemap",
          "config": { "theme": "dark", "showLabels": true }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Worker",
            "tooltip": true,
            "location": { "mode": "coords", "latitude": "lat", "longitude": "lon" },
            "config": {
              "showLegend": false,
              "style": {
                "color": { "fixed": "#22D3EE" },
                "opacity": 0.85,
                "size": { "fixed": 14, "min": 2, "max": 15 },
                "symbol": { "fixed": "img/icons/marker/circle.svg", "mode": "fixed" },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          }
        ],
        "tooltip": { "mode": "details" }
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "TEMPERATURE",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"helmet_data\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"helmet_telemetry\" and r._field == \"temp\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
