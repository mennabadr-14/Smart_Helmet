    {
        "id": "6bdaac425b4363ab",
        "type": "function",
        "z": "4a7dbdfdd986f27f",
        "name": "OwnTracks location",
        "func": "const p = msg.payload;\n// OwnTracks publishes many message types, keep only location updates\nif (!p || p._type !== 'location' || typeof p.lat !== 'number' || typeof p.lon !== 'number') return null;\nflow.set('ot', { lat: p.lat, lon: p.lon, ts: Date.now() });\nconst ui = { payload: { kind: 'location', src: 'OwnTracks', lat: p.lat, lon: p.lon, acc: p.acc, batt: p.batt } };\nconst map = { payload: { name: 'Worker-01', lat: p.lat, lon: p.lon, icon: 'fa-user', iconColor: '#9aa4b2', popup: 'OwnTracks location' } };\nreturn [ui, map];",
