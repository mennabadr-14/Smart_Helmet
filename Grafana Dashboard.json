          "noValue": "--",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#3B82F6", "value": null },
              { "color": "#F59E0B", "value": 35 },
              { "color": "#EF4444", "value": 45 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": [ "lastNotNull" ], "fields": "" },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto",
        "text": { "valueSize": 44, "titleSize": 14 }
      }
    },
