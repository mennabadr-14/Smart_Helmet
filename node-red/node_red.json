    {
        "id": "cccd115754601d2f",
        "type": "function",
        "z": "4a7dbdfdd986f27f",
        "name": "Alert -> dashboard + email",
        "func": "const a = msg.payload;\nif (!a || typeof a !== 'object') return null;\nif (a.gas === undefined && a.oxygen !== undefined) { a.gas = Math.max(0, Math.round((98 - a.oxygen) / 40 * 100)); delete a.oxygen; }   // old senders\nconst ot = flow.get('ot');\nif (ot && (Date.now() - ot.ts) < 300000) { a.lat = ot.lat; a.lon = ot.lon; }\nconst ui = { payload: Object.assign({ kind: 'alert' }, a) };\nif (a.type === 'info' || a.type === 'noise') return [ui, null];   // shown on the dashboard only, no email\nconst link = (typeof a.lat === 'number') ? 'https://www.google.com/maps?q=' + a.lat + ',' + a.lon : 'not available yet (connect OwnTracks)';\nlet det = '';\nif (a.temp !== undefined) det += 'Temperature: ' + a.temp + ' C\\n';\nif (a.gas !== undefined) det += 'Gas level: ' + a.gas + ' %\\n';\nif (a.accel !== undefined) det += 'Acceleration: ' + a.accel + ' g\\n';\nconst mail = { topic: a.message, payload: a.message + '\\n\\n' + det + 'Location: ' + link + '\\nTime: ' + new Date().toLocaleString() };\nreturn [ui, mail];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
