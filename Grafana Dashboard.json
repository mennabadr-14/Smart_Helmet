          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "from(bucket: \"helmet_data\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"helmet_telemetry\" and r._field == \"noise\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
