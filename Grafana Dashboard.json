                "FIRE": { "index": 1, "color": "#EF4444", "text": "FIRE" },
                "GAS": { "index": 2, "color": "#F59E0B", "text": "GAS" },
                "FALL": { "index": 3, "color": "#B91C1C", "text": "FALL" },
                "NOISE": { "index": 4, "color": "#FACC15", "text": "NOISE" },
                "NOT WORN": { "index": 5, "color": "#64748B", "text": "NOT WORN" }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#64748B", "value": null } ] },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
